{
  "name": "saas-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter @saas/web exec eslint --fix",
      "pnpm --filter @saas/web exec prettier --write --ignore-path ../../.prettierignore"
    ],
    "apps/api/**/*.{ts,tsx}": [
      "pnpm --filter @saas/api exec eslint --fix",
      "pnpm --filter @saas/api exec prettier --write --ignore-path ../../.prettierignore"
    ],
    "packages/shared/**/*.ts": [
      "pnpm --filter @saas/web exec prettier --write --ignore-path ../../.prettierignore"
    ],
    "**/*.{css,less,json}": [
      "pnpm --filter @saas/web exec prettier --write --ignore-path ../../.prettierignore"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "turbo": "^2.11.10"
  }
}
