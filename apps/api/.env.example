
# ── 运行时 ──
NODE_ENV=development
PORT=3000

# ── 数据库 ──
# DATABASE_URL：应用运行时连接串（Neon 用池化地址，host 带 -pooler）
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# DIRECT_URL：Prisma Migrate 专用直连地址（同串去掉 -pooler）；
# 池化地址跑迁移会报 prepared statement "s0" already exists
# 本地开发单库时可与 DATABASE_URL 相同，prisma7.config.ts 会 DIRECT_URL ?? DATABASE_URL 兜底
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# ── 测试库（e2e 专用，可选）──
# 与开发库同构的独立库，e2e 绝不写开发库。日常开发用不到，留空即可
# DATABASE_URL_TEST="postgresql://user:password@host/testdb?sslmode=require"
# DIRECT_URL_TEST：对测试库做 migrate deploy（DDL）时才需要
# DIRECT_URL_TEST="postgresql://user:password@host/testdb?sslmode=require"
# SHADOW_DATABASE_URL：migrate dev 影子库。仅当数据库账号无 CREATEDB 权限时才需要填
#（如 RDS 精简权限账号）；Neon 默认账号有 CREATEDB，留空即可自动建删临时影子库
# SHADOW_DATABASE_URL="postgresql://user:password@shadow-host/db?sslmode=require"

# ── 认证 ──
# JWT 签名密钥（openssl rand -base64 48）
JWT_SECRET="<至少 32 位随机串，openssl rand -base64 48>"
# access 有效期（秒）、refresh 有效期（天）。数字型：库的 expiresIn 类型不接受 "15m" 这种宽 string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# ── 邮件 ──
# Resend API Key（re_ 开头）。MAIL_DEV_MODE=false 时必填，否则启动即校验失败
MAIL_API_KEY=
# 开发开关：true = 不发信，验证链接打印到服务端日志（非生产环境还会回显到响应 details.verifyUrl）
# Resend 未验证域名时只能发到账号本人邮箱，本地联调必须开它
MAIL_DEV_MODE=true
# 发件人，需与 Resend 已验证域名一致；未验证时只能填 onboarding@resend.dev
MAIL_FROM="SaaS Starter <onboarding@resend.dev>"

# ── 前端联调 ──
CORS_ORIGINS=http://localhost:5173
# 验证 / 重置链接的前端前缀：${APP_WEB_URL}/verify-email?token=xxx
APP_WEB_URL=http://localhost:5173

# ── 以下按需启用（M3+ 再填）──
# REDIS_URL="redis://..."
# COS_ENDPOINT="https://xxx.cos.ap-guangzhou.myqcloud.com"
# COS_BUCKET="saas-starter-1250000000"
# SMTP_HOST="smtp.example.com"
# LLM_API_KEY="sk-..."