
# ── 运行时 ──
NODE_ENV=development
PORT=3000

# ── 数据库 ──
# DATABASE_URL：应用运行时连接串（Neon 用池化地址，host 带 -pooler）
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# DIRECT_URL：Prisma Migrate 专用直连地址（同串去掉 -pooler）；
# 池化地址跑迁移会报 prepared statement "s0" already exists
# 本地开发单库时可与 DATABASE_URL 相同，prisma7.config.ts 会 DIRECT_URL ?? DATABASE_URL 兜底
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# SHADOW_DATABASE_URL：migrate dev 影子库。仅当数据库账号无 CREATEDB 权限时才需要填
#（如 RDS 精简权限账号）；Neon 默认账号有 CREATEDB，留空即可自动建删临时影子库
# SHADOW_DATABASE_URL="postgresql://user:password@shadow-host/db?sslmode=require"

# ── 认证 ──
# JWT 签名密钥（openssl rand -base64 48）
JWT_SECRET="<至少 32 位随机串，openssl rand -base64 48>"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# 邮件服务 API Key（Resend，re_ 开头）
MAIL_API_KEY=

# ── 前端联调 ──
CORS_ORIGINS=http://localhost:5173

# ── 以下按需启用（M3+ 再填）──
# REDIS_URL="redis://..."
# COS_ENDPOINT="https://xxx.cos.ap-guangzhou.myqcloud.com"
# COS_BUCKET="saas-starter-1250000000"
# SMTP_HOST="smtp.example.com"
# LLM_API_KEY="sk-..."