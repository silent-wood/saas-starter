
# ── 运行时 ──
NODE_ENV=development
PORT=3000

# ── 数据库（运行时用池化地址，迁移用直连地址）──
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── 认证 ──
# JWT 签名密钥（openssl rand -base64 48）
JWT_SECRET="<至少 32 位随机串，openssl rand -base64 48>"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# 邮件服务 API Key（Resend，re_ 开头）
MAIL_API_KEY=

# ── 前端联调 ──
CORS_ORIGINS=http://localhost:5173

# ── 以下按需启用（M3+ 再填）──
# REDIS_URL="redis://..."
# COS_ENDPOINT="https://xxx.cos.ap-guangzhou.myqcloud.com"
# COS_BUCKET="saas-starter-1250000000"
# SMTP_HOST="smtp.example.com"
# LLM_API_KEY="sk-..."